# SQLite is the zero-configuration default. Keep this path inside the mounted data volume in Docker.
DATABASE_PATH=data/flux.db
STORAGE_BACKEND=sqlite
# Set to the public frontend origin in production; * is convenient for local Docker.
FRONTEND_ORIGIN=*
REDIS_URL=redis://redis:6379/0
FLASK_ENV=development
# Keep disabled unless an LLM provider is configured and reviewed for PII handling.
LLM_FALLBACK_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
# Gmail / Pub/Sub are optional. See README.md before enabling them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=gmail-notifications
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=
